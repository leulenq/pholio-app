<%/*
  compcard-composed.ejs — atelier-engine 2-page comp card (5.5in × 8.5in).

  v2: renders ABSOLUTE GEOMETRY from the composition plan. There are no grid
  templates or layout classes — every rect (hero, name band, photo cells,
  stats block, contact, wordmark) arrives in inches from the layout solver
  and is positioned absolutely, so the markup imposes no skeleton of its own.

  LOCALS CONTRACT (supplied by renderComposedView in routes/pdf.js):
    title       string
    profile     object                — profiles row (first_name, last_name, is_pro)
    plan        CompositionPlan v2    — composition-director output:
                  .palette { background, text, muted, accent, rule }
                  .typography { display, body, nameSize, nameTracking, nameCase,
                                nameWeight, statSize, statLabelSize, contactSize }
                  .front { imageId, crop, geometry: FrontGeometry, treatment,
                           name { placement, align, rotation }, statLine|null,
                           showContactBlock }
                  .back  { layout: BackLayout (cells/statsBlock/nameBlock/
                           contactBlock/wordmark, all inch rects), statsPlacement,
                           contact { line } }
                  .wordmark { front: rect, back: rect }   — the link target rects
    statsBlock  StatsBlock            — stats-formatter output (.lines, .inline)
    imagesById  object                — { [imageId]: image row }
    baseUrl     string                — origin for relative image paths

  Print conventions: @page 5.5in 8.5in margin 0, .comp-card-page wrapper
  (generator.js checks for it), break-after: page, Google Fonts via <link>.
  Plain text everywhere — no badges, pills, chips or backdrop-filter. The
  gradient scrim behind on-image names is a legibility device, not glass.
*/%>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title><%= title %></title>
  <%
    const safePlan = (typeof plan !== 'undefined' && plan) ? plan : {};
    const palette = safePlan.palette || {};
    const typography = safePlan.typography || {};
    const front = safePlan.front || {};
    const back = safePlan.back || {};
    const layout = back.layout || {};
    const geometry = front.geometry || {};
    const wordmarks = safePlan.wordmark || {};
    const statsLines = (typeof statsBlock !== 'undefined' && statsBlock && Array.isArray(statsBlock.lines))
      ? statsBlock.lines : [];
    const statsInline = (typeof statsBlock !== 'undefined' && statsBlock && statsBlock.inline) || '';
    const contactLine = (back.contact && back.contact.line) ? back.contact.line : '';
    const safeImagesById = (typeof imagesById !== 'undefined' && imagesById) ? imagesById : {};
    const origin = (typeof baseUrl !== 'undefined' && baseUrl) ? baseUrl : '';

    // Print export: 0.125in bleed canvas (5.75 × 8.75 trim-plus-bleed).
    // All geometry stays in trim coordinates and is offset by the bleed;
    // page-edge-bleeding imagery extends THROUGH the bleed to the new edge.
    const BLEED = (typeof printBleed !== 'undefined' && printBleed) ? 0.125 : 0;
    const PAGE_W_IN = 5.5 + 2 * BLEED;
    const PAGE_H_IN = 8.5 + 2 * BLEED;

    const bg = palette.background || '#FFFFFF';
    const text = palette.text || '#1A1815';
    const muted = palette.muted || '#6B6560';
    const accent = palette.accent || '#B8956A';
    const rule = palette.rule || '#D9D9D9';

    const displayFont = typography.display || 'Inter';
    const bodyFont = typography.body || 'Inter';
    const nameSize = typography.nameSize || '24pt';
    const nameTracking = typography.nameTracking || '0.08em';
    const nameCase = typography.nameCase === 'capitalize' ? 'capitalize' : 'uppercase';
    const nameWeight = typography.nameWeight || 500;
    const statSize = typography.statSize || '8pt';
    const statLabelSize = typography.statLabelSize || '6.5pt';
    const contactSize = typography.contactSize || '7pt';

    const fullName = `${(profile && profile.first_name) || ''} ${(profile && profile.last_name) || ''}`.trim() || 'Untitled';

    const rectStyle = (r, bleedEdges) => {
      if (!r) return 'display:none;';
      const edges = Array.isArray(bleedEdges) ? bleedEdges : [];
      let x = r.x + BLEED;
      let y = r.y + BLEED;
      let w = r.w;
      let h = r.h;
      if (BLEED) {
        if (edges.includes('left')) { x -= BLEED; w += BLEED; }
        if (edges.includes('right')) { w += BLEED; }
        if (edges.includes('top')) { y -= BLEED; h += BLEED; }
        if (edges.includes('bottom')) { h += BLEED; }
      }
      return `left:${x}in;top:${y}in;width:${w}in;height:${h}in;`;
    };

    const imgSrc = (imageId) => {
      const row = imageId != null ? safeImagesById[imageId] : null;
      if (!row) return null;
      const src = row.public_url || row.path || null;
      if (!src) return null;
      // Local uploads stay same-origin relative so the dashboard preview
      // (served via the Vite dev proxy on a different origin than the API)
      // is not blocked by Cross-Origin-Resource-Policy. Puppeteer navigates
      // to `${pdfBaseUrl}/pdf/view/:slug`, so relative paths still resolve
      // against the API origin during PDF generation. The absolute `origin`
      // prefix is kept only as a fallback when no leading slash is present.
      if (/^https?:\/\//i.test(src)) return src;
      return src.startsWith('/') ? src : `${origin}/${src}`;
    };

    const heroSrc = imgSrc(front.imageId);
    const heroCrop = front.crop || {};
    const nameBand = geometry.nameBand || null;
    const nameOnImage = Boolean(nameBand && nameBand.onImage);
    const nameInk = nameOnImage && nameBand.inkOn === 'light' ? '#FFFFFF' : text;
    const verticalName = Boolean(front.name && front.name.rotation === -90 && front.treatment === 'full-bleed');
    const cells = Array.isArray(layout.cells) ? layout.cells : [];
    const statsRect = layout.statsBlock || null;
    const statsColumn = Boolean(statsRect && statsRect.orientation === 'column');

    // v3: the director supplies a library-built fonts URL (curated families
    // + their real weights); the inline builder remains as a fallback.
    let fontsUrl = typography.fontsUrl || null;
    if (!fontsUrl) {
      const families = new Set([displayFont, bodyFont, 'Inter']);
      const familyParam = [...families].map((f) => {
        const weights = f === 'Inter' ? '300;400;500;600;700' : '400;500;600';
        return `family=${f.replace(/ /g, '+')}:wght@${weights}`;
      }).join('&');
      fontsUrl = `https://fonts.googleapis.com/css2?${familyParam}&display=swap`;
    }

    // v3: measured contrast control — scrim direction + strength come from
    // the contrast engine, not fixed values.
    const scrim = front.scrim || null;
    const scrimAlpha = scrim ? Math.min(0.72, Math.max(0.15, scrim.strength)) : 0;
    const scrimColor = scrim && scrim.direction === 'lighten' ? '250,249,246' : '10,9,8';

    // Brand mark: ALWAYS gold (brand rule) — bright gold over dark imagery,
    // deep gold on paper. Placement + alignment decided by the engine from
    // quiet zones and interference. The ↗ cue + short URL signal that the
    // mark opens the talent's live portfolio (link annotation / NFC / OCR).
    const wordmarkGold = wordmarks.tone === 'gold-bright' ? '#C9A55A' : '#A6845C';
    const wordmarkJustify = wordmarks.align === 'left' ? 'flex-start' : 'flex-end';
    const wordmarkUrl = wordmarks.displayUrl || null;

    // Booking block: representation or BOOKINGS framing (industry standard).
    const booking = back.booking || null;

    // ── Editions (plan 2.8/2.9) — ADDITIVE, inert for legacy programs ──────
    // An edition render carries plan.edition and/or a back-style/nameplate
    // object. When none is present the block below emits nothing and the
    // document is byte-identical to the pre-editions template.
    const edition = (safePlan.edition && safePlan.edition.id) ? safePlan.edition : null;
    const backStyle = (layout && layout.style && typeof layout.style === 'object') ? layout.style : null;
    const backNameplate = (layout && layout.nameplate && typeof layout.nameplate === 'object') ? layout.nameplate : null;
    const editionActive = Boolean(edition || backStyle || backNameplate);

    // Dark-paper detection (linear luminance). For a light paper this yields
    // false, so the empty-cell override never fires on legacy renders.
    const hexLuminance = (hex) => {
      const m = /^#?([0-9a-f]{6})$/i.exec(String(hex || '').trim());
      if (!m) return 1;
      const n = parseInt(m[1], 16);
      const chan = (v) => { const c = v / 255; return c <= 0.03928 ? c / 12.92 : Math.pow((c + 0.055) / 1.055, 2.4); };
      return 0.2126 * chan((n >> 16) & 255) + 0.7152 * chan((n >> 8) & 255) + 0.0722 * chan(n & 255);
    };
    const paperIsDark = (palette.dark === true) || hexLuminance(bg) < 0.35;

    // Cutout source for cover-story / cutout figure layers. The route passes
    // one when a matted cutout image exists; otherwise null → the figure
    // layer degrades to the base photo src (visual degradation, never break).
    const cutoutHeroSrc = (typeof cutoutSrc !== 'undefined' && cutoutSrc) ? cutoutSrc : null;

    // Back stats presentation: style.statsStyle overrides the orientation
    // default when present; absent ⇒ today's column/strip pick (byte-safe).
    const statsColumnDefault = statsColumn ? 'column' : 'strip';
    const statsStyle = backStyle && backStyle.statsStyle && backStyle.statsStyle !== 'auto'
      ? backStyle.statsStyle
      : statsColumnDefault;
    const backDividers = Boolean(backStyle && backStyle.dividers);
    const backCellIndexes = Boolean(backStyle && backStyle.cellIndexes);
    const backRunningHead = Boolean(backNameplate && backNameplate.scale === 'running-head');
    // Back-name horizontal alignment: nameplate.align when a nameplate is
    // present, else the front name's alignment (byte-identical for legacy).
    const backJustify = (backNameplate && backNameplate.align)
      ? (backNameplate.align === 'center' ? 'center' : backNameplate.align === 'right' ? 'flex-end' : 'flex-start')
      : ((front.name && front.name.align) === 'center' ? 'center' : 'flex-start');
  %>
  <%
    // Vendored fonts: the same TTFs the composition engine measured with,
    // served same-origin — deterministic rendering, no CDN dependency.
    const localFontsCss = (typeof fontsCss !== 'undefined' && fontsCss) ? fontsCss : null;
  %>
  <% if (localFontsCss) { %>
  <style><%- localFontsCss %></style>
  <% } else { %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="<%= fontsUrl %>">
  <link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400;0,6..96,500;1,6..96,400&display=swap" rel="stylesheet">
  <% } %>
  <style>
    @page { size: <%= PAGE_W_IN %>in <%= PAGE_H_IN %>in; margin: 0; }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html, body { background: <%= bg %>; }
    body { font-family: '<%= bodyFont %>', sans-serif; color: <%= text %>; }

    .comp-card-page {
      position: relative;
      width: <%= PAGE_W_IN %>in;
      height: <%= PAGE_H_IN %>in;
      overflow: hidden;
      background: <%= bg %>;
      break-after: page;
    }
    .comp-card-page:last-child { break-after: auto; }

    .abs { position: absolute; }
    .cell img, .hero img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    .hero { overflow: hidden; }
    .cell { overflow: hidden; }
    .cell-empty { width: 100%; height: 100%; background: <%= rule %>; opacity: 0.18; }

    .name {
      font-family: '<%= displayFont %>', serif;
      font-size: <%= nameSize %>;
      font-weight: <%= nameWeight %>;
      letter-spacing: <%= nameTracking %>;
      text-transform: <%= nameCase %>;
      line-height: 1.04;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
    .name--left { align-items: flex-start; text-align: left; }
    .name--center { align-items: center; text-align: center; }

    /* Legibility scrim for on-image names — a gradient, not glass. The
       alpha is solved by the contrast engine from the measured band luma. */
    .scrim-top, .scrim-bottom {
      position: absolute;
      left: 0; right: 0;
      height: 1.7in;
      pointer-events: none;
    }
    .scrim-top { top: 0; background: linear-gradient(to bottom, rgba(<%= scrimColor %>,<%= scrimAlpha %>), rgba(<%= scrimColor %>,0)); }
    .scrim-bottom { bottom: 0; background: linear-gradient(to top, rgba(<%= scrimColor %>,<%= scrimAlpha %>), rgba(<%= scrimColor %>,0)); }

    .vertical-spine {
      position: absolute;
      left: 0.28in;
      top: 0.25in;
      height: 8in;
      writing-mode: vertical-rl;
      transform: rotate(180deg);
      display: flex;
      align-items: center;
    }

    .stat-line-front {
      font-size: 6.5pt;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      white-space: nowrap;
      overflow: hidden;
      display: flex;
      align-items: center;
    }

    .back-name {
      font-family: '<%= displayFont %>', serif;
      font-weight: <%= nameWeight %>;
      letter-spacing: <%= nameTracking %>;
      text-transform: <%= nameCase %>;
      display: flex;
      align-items: center;
    }

    .stats { display: flex; overflow: hidden; }
    .stats--column {
      flex-direction: column;
      justify-content: flex-start;
      gap: 0.085in;
      border-left: 0.75pt solid <%= rule %>;
      padding-left: 0.12in;
    }
    .stats--strip {
      flex-direction: row;
      flex-wrap: wrap;
      align-content: center;
      column-gap: 0.22in;
      row-gap: 0.06in;
      border-top: 0.75pt solid <%= rule %>;
      padding-top: 0.1in;
    }
    .stat { display: flex; flex-direction: column; gap: 0.014in; }
    .stat-label {
      font-size: <%= statLabelSize %>;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: <%= accent %>;
    }
    .stat-value { font-size: <%= statSize %>; color: <%= text %>; }

    .contact {
      font-size: <%= contactSize %>;
      letter-spacing: 0.06em;
      color: <%= muted %>;
      display: flex;
      align-items: center;
      overflow: hidden;
      white-space: nowrap;
    }

    .wordmark {
      font-family: 'Inter', sans-serif;
      font-size: 6.5pt;
      font-weight: 600;
      letter-spacing: 0.34em;
      text-transform: uppercase;
      color: <%= wordmarkGold %>;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: <%= wordmarkJustify %>;
      gap: 0.018in;
    }
    .wordmark .mark-url {
      font-size: 4.6pt;
      font-weight: 400;
      letter-spacing: 0.08em;
      text-transform: lowercase;
      opacity: 0.85;
    }

    /* (Removed: the hardcoded split-layout override block. It forced an
       unverified gold #C9A55A on 7.2pt contact type (≈2.2:1 on paper) and
       repositioned engine-solved geometry with !important — micro-type
       colors must flow from verified palette roles only.) */
  </style>
<% if (editionActive) { -%>
  <%/* Editions-only CSS. Gated on editionActive so a legacy program render
       is byte-identical to the pre-editions template. Carries: tabular
       numerals on all stat values (front + back), the footline/tabular
       stat chrome, cell dividers + index numerals, the running-head
       nameplate scale, and the dark-paper empty-cell override. */%>
  <style>
    .stat-value, .stat-line-front { font-variant-numeric: tabular-nums; }

    /* footline — one foot row: tracked labels, tabular values */
    .stats--footline {
      flex-direction: row;
      flex-wrap: nowrap;
      align-items: baseline;
      column-gap: 0.2in;
      border-top: 0.5pt solid <%= rule %>;
      padding-top: 0.08in;
    }
    .stats--footline .stat {
      flex-direction: row;
      align-items: baseline;
      gap: 0.05in;
    }

    /* tabular — ruled rows: label left, value right, hairline row rules */
    .stats--tabular { flex-direction: column; }
    .stats--tabular .stat-row {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 0.14in;
      padding: 0.028in 0;
      border-bottom: 0.5pt solid <%= rule %>;
    }
    .stats--tabular .stat-row .stat-value { font-variant-numeric: tabular-nums; }

    /* per-cell hairline dividers + foot-left index numerals */
    .cell-divider { background: <%= rule %>; pointer-events: none; z-index: 5; }
    .cell-index {
      font-family: 'Inter', sans-serif;
      font-size: 5.4pt;
      font-weight: 500;
      letter-spacing: 0.14em;
      color: <%= muted %>;
      pointer-events: none;
      z-index: 6;
    }

    /* running-head nameplate: the back name echoes the FRONT display family
       (already set on .back-name) at a small, tracked scale */
    .back-name--running-head { letter-spacing: 0.24em; }

    <% if (paperIsDark) { %>
    /* dark paper: empty cells derive from light ink at low alpha (the
       light-paper rgba values would vanish on a night field) */
    .cell-empty { background: <%= muted %>; opacity: 0.22; }
    <% } %>
  </style>
<% } -%>
</head>
<body data-compcard-engine="composed" data-compcard-seed="<%= safePlan.seedUsed || 'auto' %>" data-compcard-tone="<%= safePlan.toneProfile || '' %>">

  <%
    // v4: when a synthesized front PROGRAM is supplied, render its element
    // tree (a grammar-sampled composition); otherwise the legacy front.
    const fp = (typeof frontProgram !== 'undefined' && frontProgram && Array.isArray(frontProgram.elements))
      ? frontProgram : null;
    const fpEls = fp ? fp.elements.slice().sort((a, b) => (a.z || 0) - (b.z || 0)) : [];
    const fpScrim = (e) => {
      if (!e.scrim) return '';
      const a = Math.min(0.72, Math.max(0.15, e.scrim.strength || 0.4));
      const col = e.scrim.direction === 'lighten' ? '250,249,246' : '10,9,8';
      const edge = e.scrim.edge === 'top' ? 'to bottom' : 'to top';
      const pos = e.scrim.edge === 'top' ? 'top:0;' : 'bottom:0;';
      // z-index must sit ABOVE the photo plane (z 10) and BELOW on-photo
      // type (z 30+). Without it the scrim paints at level 0 UNDER the
      // z-positioned photo and contributes zero pixels — the solved
      // contrast never materializes (audit P0-2, proven by pixel test).
      return `<div class="abs" data-scrim style="left:0;right:0;${pos}height:1.7in;pointer-events:none;z-index:12;background:linear-gradient(${edge}, rgba(${col},${a}), rgba(${col},0));"></div>`;
    };
    // Variable-axis CSS (Phase 4): a name element may carry axes { wdth?,
    // opsz? } resolved by the engine and measured against the vendored
    // variable master. Emitting font-variation-settings makes Chromium
    // render (and bake into the PDF) the exact instance the widths were
    // solved at. Null/absent axes → empty string → the static face, so
    // legacy programs are unaffected. wght rides the existing font-weight.
    const fvs = (axes) => {
      if (!axes || typeof axes !== 'object') return '';
      const parts = [];
      if (Number.isFinite(Number(axes.wdth))) parts.push(`"wdth" ${Number(axes.wdth)}`);
      if (Number.isFinite(Number(axes.opsz))) parts.push(`"opsz" ${Number(axes.opsz)}`);
      return parts.length ? ` font-variation-settings: ${parts.join(', ')};` : '';
    };
  %>
  <%/* ───────────── PAGE 1 — FRONT ───────────── */%>
  <% if (fp) { %>
  <div class="comp-card-page" id="front" data-structure="<%= fp.structure %>">
    <% fpEls.forEach((e) => { %>
      <% if (e.type === 'colorPlane') { %>
        <div class="abs color-plane" style="<%= rectStyle(e.rect, e.bleedEdges) %> background: <%= e.fill %>; z-index: <%= Math.round((e.z||0)*10) %>;"></div>
      <% } else if (e.type === 'photo') {
           // imageId → that image; a 'figure' cutout layer → the cutout src
           // when the route supplied one, else the base photo (degrade); a
           // plain hero element → heroSrc, exactly as before.
           const isFigure = e.layer === 'figure';
           const src = e.imageId != null
             ? imgSrc(e.imageId)
             : (isFigure ? (cutoutHeroSrc || heroSrc) : heroSrc);
           // per-element crop wins; an imageId photo defaults centered; a
           // hero/figure element inherits the solved hero crop (byte-safe). */
           const objPos = (e.crop && e.crop.objectPosition)
             ? e.crop.objectPosition
             : (e.imageId != null ? '50% 50%' : (heroCrop.objectPosition || '50% 50%')); %>
        <div class="abs hero" style="<%= rectStyle(e.rect, e.bleedEdges) %> z-index: <%= Math.round((e.z||0)*10) %>;">
          <% if (src) { %><img src="<%= src %>" alt="<%= fullName %>" style="object-position: <%= objPos %>;"><% } else { %><div class="cell-empty"></div><% } %>
        </div>
        <% if (e.scrimForName) { %><%- fpScrim(e.scrimForName) %><% } %>
      <% } else if (e.type === 'ghost') { %>
        <div class="abs" data-ghost style="<%= rectStyle(e.rect) %> z-index: <%= Math.round((e.z||0)*10) %>; overflow: hidden;">
          <span style="font-family: '<%= displayFont %>', serif; font-size: <%= e.sizePt %>pt; font-weight: 700; letter-spacing: 0.02em; text-transform: uppercase; color: <%= e.color %>; opacity: <%= e.opacity %>; white-space: nowrap; line-height: 1;"><%= fullName %></span>
        </div>
      <% } else if (e.type === 'band') { %>
        <div class="abs" style="<%= rectStyle(e.rect) %> z-index: <%= Math.round((e.z||0)*10) %>; background: <%= e.fill %>;"></div>
      <% } else if (e.type === 'rule' && e.variant === 'frame') { %>
        <div class="abs" style="<%= rectStyle(e.rect) %> z-index: <%= Math.round((e.z||0)*10) %>; border: <%= (e.weight||0.01) %>in solid <%= e.color %>;"></div>
      <% } else if (e.type === 'rule' && (e.variant === 'hairline' || e.variant === 'hinge')) { %>
        <%/* hairline / hinge: the rect IS the line box — a filled div (the
             thin dimension already lives in the rect); weight is informational */%>
        <div class="abs" style="<%= rectStyle(e.rect) %> z-index: <%= Math.round((e.z||0)*10) %>; background: <%= e.color %>;"></div>
      <% } else if (e.type === 'folio') { %>
        <%/* folio — the one earned ornament: a small tracked imprint line */%>
        <div class="abs" data-folio style="<%= rectStyle(e.rect) %> z-index: <%= Math.round((e.z||0)*10) %>; display:flex; align-items:center; justify-content: <%= e.align === 'right' ? 'flex-end' : (e.align === 'center' ? 'center' : 'flex-start') %>; overflow:hidden;">
          <span style="font-family: 'Inter', sans-serif; font-size: <%= e.sizePt %>pt; font-weight: <%= e.weight || 600 %>; letter-spacing: <%= e.trackingEm != null ? e.trackingEm : 0.2 %>em; text-transform: <%= e.transform || 'uppercase' %>; color: <%= e.color %>; white-space: nowrap;"><%= e.text %></span>
        </div>
      <% } else if (e.type === 'name') { const nameSource = e.text || fullName; const lines = e.stacked && nameSource.includes(' ') ? [nameSource.split(/\s+/)[0], nameSource.split(/\s+/).slice(1).join(' ')] : [nameSource]; const nameLeading = (e.leading != null) ? e.leading : 1.05; %>
        <% if (e.scrim) { %><%- fpScrim(e) %><% } %>
        <div class="abs name-block" data-fit-text style="<%= rectStyle(e.rect) %> z-index: <%= Math.round((e.z||0)*10) %>; display:flex; flex-direction: column; justify-content: center; color: <%= e.color %>; <%= e.orientation === 'vertical' ? 'writing-mode: vertical-rl; transform: rotate(180deg); align-items: center;' : (e.align === 'center' ? 'align-items: center; text-align: center;' : 'align-items: flex-start;') %>">
          <% lines.forEach((ln) => { %><span style="font-family: '<%= e.font === 'body' ? bodyFont : displayFont %>', <%= e.font === 'body' ? 'sans-serif' : 'serif' %>; font-size: <%= e.sizePt %>pt; font-weight: <%= e.weight || nameWeight %>; letter-spacing: <%= e.trackingEm %>em; text-transform: <%= e.transform || nameCase %>; line-height: <%= nameLeading %>; white-space: nowrap;<%- fvs(e.axes) %><%= (e.opacity != null && e.opacity < 1) ? ` opacity: ${e.opacity};` : '' %>"><%= ln %></span><% }); %>
        </div>
      <% } else if (e.type === 'contact') { %>
        <div class="abs contact-line" style="<%= rectStyle(e.rect) %> z-index: <%= Math.round((e.z||0)*10) %>; display:flex; align-items:center; color: <%= e.color %>; <%= e.orientation === 'vertical' ? 'writing-mode: vertical-rl; transform: rotate(180deg);' : '' %>">
          <span style="font-family: 'Inter', sans-serif; font-size: <%= e.sizePt %>pt; letter-spacing: 0.14em; text-transform: uppercase; white-space: nowrap;"><%= e.text %></span>
        </div>
      <% } %>
    <% }); %>
    <%/* Front carries no wordmark — the gold signature lives on the back. */%>
  </div>
  <% } else { %>
  <div class="comp-card-page" id="front">
    <div class="abs hero" style="<%= rectStyle(geometry.hero, geometry.hero.bleedEdges) %>">
      <% if (heroSrc) { %>
        <img src="<%= heroSrc %>" alt="<%= fullName %>"
             style="object-position: <%= (heroCrop.objectPosition || '50% 50%') %>;">
      <% } else { %>
        <div class="cell-empty"></div>
      <% } %>
      <% if (nameOnImage && scrim && !verticalName) { %>
        <div class="<%= (front.name && front.name.placement === 'top') ? 'scrim-top' : 'scrim-bottom' %>"></div>
      <% } %>
    </div>

    <% if (verticalName) { %>
      <div class="vertical-spine name name--left" data-fit-text style="color: <%= nameInk %>;">
        <span><%= fullName %></span>
      </div>
    <% } else { %>
      <div class="abs name name--<%= (front.name && front.name.align) === 'center' ? 'center' : 'left' %>" data-fit-text
           style="<%= rectStyle(nameBand) %> color: <%= nameInk %>;">
        <% const nameLines = (front.name && Array.isArray(front.name.lines)) ? front.name.lines : [fullName]; %>
        <% nameLines.forEach((line) => { %><span style="white-space: nowrap;"><%= line %></span><% }); %>
        <% if (front.showContactBlock && contactLine) { %>
          <span style="font-family:'Inter',sans-serif;font-size:<%= contactSize %>;font-weight:400;letter-spacing:0.1em;text-transform:none;margin-top:0.06in;color:<%= nameOnImage && nameInk === '#FFFFFF' ? 'rgba(255,255,255,0.78)' : muted %>;">
            <%= contactLine %>
          </span>
        <% } %>
      </div>
    <% } %>

    <% const frontStatText = front.statLineText || statsInline; %>
    <% if (front.statLine && frontStatText) { %>
      <div class="abs stat-line-front"
           style="<%= rectStyle(front.statLine) %> color: <%= nameOnImage && nameInk === '#FFFFFF' ? 'rgba(255,255,255,0.85)' : muted %>;">
        <span style="overflow:hidden;text-overflow:ellipsis;"><%= frontStatText %></span>
      </div>
    <% } %>

    <%/* Front carries no wordmark — the gold signature lives on the back. */%>
  </div>
  <% } %>

  <%/* ───────────── PAGE 2 — BACK ───────────── */%>
  <div class="comp-card-page" id="back">
    <div class="abs back-name<%= backRunningHead ? ' back-name--running-head' : '' %> name--<%= (front.name && front.name.align) === 'center' ? 'center' : 'left' %>" data-fit-text
         style="<%= rectStyle(layout.nameBlock) %> font-size: calc(<%= nameSize %> * <%= backRunningHead ? '0.3' : '0.42' %>); justify-content: <%= backJustify %>;">
      <span><%= fullName %></span>
    </div>

    <% cells.forEach((cell) => { const src = imgSrc(cell.imageId); const contained = cell.crop && cell.crop.fit === 'contain'; %>
      <div class="abs cell" style="<%= rectStyle(cell, cell.bleedEdges) %>">
        <% if (src) { %>
          <img src="<%= src %>" alt=""
               style="object-position: <%= (cell.crop && cell.crop.objectPosition) || '50% 50%' %>;<%= contained ? ' object-fit: contain;' : '' %>">
        <% } else { %>
          <div class="cell-empty"></div>
        <% } %>
      </div>
    <% }); %>
<% if (backDividers) { cells.forEach((cell) => { -%>
      <div class="abs cell-divider" style="left:<%= cell.x + cell.w + BLEED %>in; top:<%= cell.y + BLEED %>in; width:0.007in; height:<%= cell.h %>in;"></div>
      <div class="abs cell-divider" style="left:<%= cell.x + BLEED %>in; top:<%= cell.y + cell.h + BLEED %>in; width:<%= cell.w %>in; height:0.007in;"></div>
<% }); } -%>
<% if (backCellIndexes) { cells.forEach((cell, i) => { -%>
      <div class="abs cell-index" style="left:<%= cell.x + BLEED + 0.05 %>in; top:<%= cell.y + cell.h + BLEED - 0.17 %>in;"><%= String(i + 1).padStart(2, '0') %></div>
<% }); } -%>

    <% if (statsRect && statsLines.length) { %>
<% if (editionActive && statsStyle === 'footline') { -%>
      <div class="abs stats stats--footline" style="<%= rectStyle(statsRect) %>">
        <% statsLines.forEach((line) => { %>
          <div class="stat">
            <span class="stat-label"><%= line.label %></span>
            <span class="stat-value"><%= line.value %></span>
          </div>
        <% }); %>
      </div>
<% } else if (editionActive && statsStyle === 'tabular') { -%>
      <div class="abs stats stats--tabular" style="<%= rectStyle(statsRect) %>">
        <% statsLines.forEach((line) => { %>
          <div class="stat-row">
            <span class="stat-label"><%= line.label %></span>
            <span class="stat-value"><%= line.value %></span>
          </div>
        <% }); %>
      </div>
<% } else { -%>
      <div class="abs stats <%= editionActive ? (statsStyle === 'column' ? 'stats--column' : 'stats--strip') : (statsColumn ? 'stats--column' : 'stats--strip') %>"
           style="<%= rectStyle(statsRect) %>">
        <% statsLines.forEach((line) => { %>
          <div class="stat">
            <span class="stat-label"><%= line.label %></span>
            <span class="stat-value"><%= line.value %></span>
          </div>
        <% }); %>
      </div>
<% } -%>
    <% } %>

    <% if (booking && (booking.primary || booking.line)) { %>
      <%/* Representation and direct bookings share one premium hierarchy:
           micro label / primary channel / supporting line. */%>
      <div class="abs contact" style="<%= rectStyle(layout.contactBlock) %> flex-direction: column; align-items: flex-start; justify-content: center; gap: 0.022in; white-space: normal;">
        <% if (booking.label) { %>
          <span style="font-size: 5.4pt; letter-spacing: 0.22em; text-transform: uppercase; color: <%= accent %>;"><%= booking.label %></span>
        <% } %>
        <% if (booking.primary) { %>
          <span style="font-size: 8pt; font-weight: 500; letter-spacing: 0.04em; color: <%= text %>; white-space: nowrap;"><%= booking.primary %></span>
        <% } %>
        <% if (booking.line) { %><span style="white-space: nowrap;"><%= booking.line %></span><% } %>
      </div>
    <% } else if (contactLine) { %>
      <div class="abs contact" style="<%= rectStyle(layout.contactBlock) %>">
        <span><%= contactLine %></span>
      </div>
    <% } %>

    <div class="abs wordmark" style="<%= rectStyle(layout.wordmark) %> align-items: flex-end;">
      <span>Pholio</span>
      <% if (wordmarkUrl) { %><span class="mark-url"><%= wordmarkUrl %></span><% } %>
    </div>
  </div>

  <script>
    // Rendered-geometry hard guard (audit P0-1). The engine solves sizes
    // from measured glyph metrics, but the page is the final authority: any
    // name that still renders wider/taller than its solved rect is scaled to
    // fit, and a ghost echo that cannot render as a complete word is removed
    // rather than shipped as amputated glyph fragments. Runs in both the
    // dashboard preview iframe and the Puppeteer PDF pass; the report lands
    // on <body data-name-fit> for the generator/tests to assert on.
    (function () {
      function fitAll() {
        var report = { checked: 0, adjusted: 0, ghostsRemoved: 0, minScale: 1, floorHits: 0 };
        // Booker's law: the name never renders below 14pt effective. 1pt =
        // 4/3 CSS px, so the rescale floor is 14 * 4/3 ≈ 18.67px. Hitting
        // the floor is reported as floorHits — the generator treats it as a
        // failed take (the composer shipped unverifiable geometry), never a
        // silent 6pt name.
        var FLOOR_PX = 14 * (4 / 3);
        document.querySelectorAll('[data-fit-text]').forEach(function (box) {
          var boxRect = box.getBoundingClientRect();
          if (!boxRect.width || !boxRect.height) return;
          box.querySelectorAll('span').forEach(function (span) {
            report.checked += 1;
            var r = span.getBoundingClientRect();
            var scale = Math.min(
              boxRect.width / Math.max(r.width, 1),
              boxRect.height / Math.max(r.height, 1)
            );
            if (scale < 0.995) {
              var size = parseFloat(getComputedStyle(span).fontSize);
              var target = size * scale * 0.995;
              // Only the display name is floor-gated; micro-type (contact,
              // stats) has its own solved sizes and never reaches here at
              // display scale. Identify name spans by their box role.
              var isName = box.classList.contains('name') || box.classList.contains('name-block') || box.classList.contains('back-name');
              if (isName && size >= FLOOR_PX && target < FLOOR_PX) {
                target = FLOOR_PX;
                report.floorHits += 1;
              }
              span.style.fontSize = Math.max(target, 8) + 'px';
              report.adjusted += 1;
              if (scale < report.minScale) report.minScale = Math.round(scale * 1000) / 1000;
            }
          });
        });
        document.querySelectorAll('[data-ghost]').forEach(function (box) {
          var span = box.querySelector('span');
          if (!span) return;
          var boxRect = box.getBoundingClientRect();
          var r = span.getBoundingClientRect();
          if (r.width > boxRect.width + 0.5 || r.height > boxRect.height + 2) {
            box.style.display = 'none';
            report.ghostsRemoved += 1;
          }
        });
        document.body.setAttribute('data-name-fit', JSON.stringify(report));
        document.body.setAttribute('data-name-fit-done', '1');
      }
      if (document.fonts && document.fonts.ready) {
        document.fonts.ready.then(fitAll, fitAll);
      } else {
        fitAll();
      }
    })();
  </script>
</body>
</html>
