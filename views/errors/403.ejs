<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Access Denied · Pholio</title>
  <style>
    body { margin: 0; min-height: 100vh; display: flex; align-items: center; justify-content: center;
      background: #FAF7F2; color: #1A1A1A; font-family: Georgia, "Times New Roman", serif; }
    .wrap { text-align: center; padding: 48px 24px; max-width: 32rem; }
    .mark { color: #C9A55A; letter-spacing: 0.2em; font-size: 14px; margin-bottom: 24px; }
    h1 { font-weight: 400; font-size: 28px; margin: 0 0 12px; }
    p { font-family: system-ui, sans-serif; font-size: 15px; color: rgba(26,26,26,0.62); }
  </style>
</head>
<body>
  <div class="wrap">
    <div class="mark">PHOLIO</div>
    <h1>Access denied</h1>
    <p><%= typeof error !== 'undefined' && error && error.message ? error.message : 'You do not have permission to view this page.' %></p>
  </div>
</body>
</html>
