.pcz-page {
  min-height: calc(100vh - 56px);
  background: #faf7f2;
  color: #1a1a1a;
}

.pcz-hero {
  position: relative;
  background: #050505;
  color: #fff;
  padding: 72px 0 56px;
  overflow: hidden;
}

.pcz-hero::before {
  content: '';
  position: absolute;
  inset: 0;
  background: radial-gradient(circle at 50% 58%, rgba(201, 165, 90, 0.1) 0%, transparent 62%);
}

.pcz-hero__grain {
  position: absolute;
  inset: 0;
  pointer-events: none;
  opacity: 0.035;
  mix-blend-mode: soft-light;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.7' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
  background-size: 150px 150px;
}

.pcz-hero__inner {
  position: relative;
  z-index: 1;
  max-width: 1240px;
  margin: 0 auto;
  padding: 0 48px;
}

.pcz-hero__meta {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 28px;
}

.pcz-micro {
  font-family: 'JetBrains Mono', 'SF Mono', ui-monospace, monospace;
  font-size: 10px;
  letter-spacing: 0.28em;
  text-transform: uppercase;
  color: #c9a55a;
}

.pcz-divider {
  width: 24px;
  height: 1px;
  background: #c8a96e;
}

.pcz-meta-value {
  font-size: 12px;
  color: rgba(255, 255, 255, 0.48);
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.pcz-title {
  margin: 0;
  font-family: 'Noto Serif Display', Georgia, serif;
  font-weight: 400;
  letter-spacing: -0.02em;
  line-height: 1.02;
  font-size: clamp(34px, 5.4vw, 72px);
  max-width: 12ch;
}

.pcz-title em {
  font-style: italic;
  color: #c9a55a;
  font-weight: 400;
}

.pcz-lede {
  margin: 28px 0 0;
  max-width: 56ch;
  font-size: 16px;
  line-height: 1.72;
  font-weight: 300;
  color: rgba(255, 255, 255, 0.6);
}

.pcz-body {
  padding: 40px 0 64px;
}

.pcz-wrap {
  max-width: 1240px;
  margin: 0 auto;
  padding: 0 48px;
}

.pcz-grid {
  display: grid;
  grid-template-columns: minmax(280px, 1fr) minmax(320px, 420px);
  gap: 30px;
  align-items: start;
}

.pcz-left {
  display: grid;
  gap: 16px;
}

.pcz-panel {
  background: #fff;
  border: 1px solid rgba(26, 26, 26, 0.08);
  border-radius: 10px;
  padding: 18px 18px 16px;
}

.pcz-label {
  display: inline-block;
  margin-bottom: 10px;
  font-family: 'JetBrains Mono', 'SF Mono', ui-monospace, monospace;
  font-size: 10px;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: #c9a55a;
}

.pcz-name {
  margin: 0;
  font-family: 'Noto Serif Display', Georgia, serif;
  font-size: 28px;
  font-weight: 400;
  letter-spacing: -0.02em;
  line-height: 1.08;
  color: #1a1a1a;
}

.pcz-name em {
  font-style: italic;
  color: #c9a55a;
}

.pcz-small {
  margin: 12px 0 0;
  font-size: 14px;
  line-height: 1.62;
  color: rgba(26, 26, 26, 0.62);
}

.pcz-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: grid;
  gap: 10px;
}

.pcz-list li {
  display: grid;
  grid-template-columns: 16px 1fr;
  gap: 10px;
  align-items: start;
  color: rgba(26, 26, 26, 0.74);
  font-size: 13px;
  line-height: 1.52;
}

.pcz-list li svg {
  margin-top: 2px;
  color: #c9a55a;
}

.pcz-actions {
  display: grid;
  gap: 8px;
}

.pcz-link {
  display: inline-flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  width: 100%;
  border: 1px solid rgba(201, 165, 90, 0.24);
  border-radius: 8px;
  background: #faf7f2;
  padding: 10px 12px;
  text-decoration: none;
  color: #1a1a1a;
  font-size: 13px;
  font-weight: 500;
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}

.pcz-link:hover {
  border-color: rgba(201, 165, 90, 0.48);
  background: #f5f0e8;
}

.pcz-right {
  position: sticky;
  top: 84px;
}

.pcz-preview-shell {
  background: #fff;
  border: 1px solid rgba(26, 26, 26, 0.08);
  border-radius: 10px;
  padding: 16px;
  box-shadow: 0 10px 24px rgba(5, 5, 5, 0.05);
}

.pcz-preview-shell .ccp-root {
  position: static;
  top: auto;
}

.pcz-loading {
  min-height: 320px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(26, 26, 26, 0.46);
  font-size: 13px;
}

.pcz-sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

@media (max-width: 1100px) {
  .pcz-grid {
    grid-template-columns: 1fr;
  }

  .pcz-right {
    position: static;
    top: auto;
  }
}

@media (max-width: 720px) {
  .pcz-hero__inner,
  .pcz-wrap {
    padding: 0 24px;
  }

  .pcz-hero {
    padding: 56px 0 44px;
  }

  .pcz-body {
    padding: 28px 0 40px;
  }
}
