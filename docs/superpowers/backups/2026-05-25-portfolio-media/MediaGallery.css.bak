@keyframes book-entrance {
  from {
    opacity: 0;
    transform: translateY(10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes book-shimmer {
  0% {
    background-position: -720px 0;
  }
  100% {
    background-position: 720px 0;
  }
}

@keyframes book-action-spin {
  to {
    transform: rotate(360deg);
  }
}

.book-container {
  --book-ink: #050505;
  --book-text: #1a1a1a;
  --book-text-soft: rgba(26, 26, 26, 0.64);
  --book-text-faint: rgba(26, 26, 26, 0.42);
  --book-cream: #faf7f2;
  --book-cream-warm: #f5f0e8;
  --book-cream-dark: #ede8dd;
  --book-paper: #fffdf8;
  --book-gold: #c9a55a;
  --book-gold-warm: #c8a96e;
  --book-sage: #778f74;
  --book-danger: #9c3d35;
  --book-hair: rgba(5, 5, 5, 0.1);
  --book-hair-soft: rgba(5, 5, 5, 0.065);
  --book-hair-gold: rgba(201, 165, 90, 0.28);
  --book-radius: 8px;
  --book-ease: cubic-bezier(0.22, 1, 0.36, 1);

  position: relative;
  min-height: calc(100vh - 68px);
  padding: 46px clamp(18px, 4vw, 56px) 72px;
  overflow: hidden;
  background: linear-gradient(180deg, #050505 0%, #090806 38%, #050505 100%);
  color: rgba(245, 240, 232, 0.9);
  font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  animation: book-entrance 0.36s var(--book-ease) both;
}

.book-container::before {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  opacity: 0.035;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='2' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
  background-size: 160px 160px;
  mix-blend-mode: screen;
}

.book-container > * {
  position: relative;
  z-index: 1;
}

.book-file-input {
  display: none;
}

.book-kicker {
  display: block;
  color: var(--book-gold);
  font-family: "JetBrains Mono", "SF Mono", Menlo, monospace;
  font-size: 0.66rem;
  font-weight: 600;
  letter-spacing: 0;
  line-height: 1;
  text-transform: uppercase;
}

.book-command-bar,
.book-studio {
  width: min(100%, 1500px);
  margin-right: auto;
  margin-left: auto;
}

.book-command-bar {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(340px, auto) auto;
  gap: 24px;
  align-items: end;
  padding-bottom: 34px;
  border-bottom: 1px solid rgba(245, 240, 232, 0.12);
}

.book-command-title {
  min-width: 0;
}

.book-command-title h1 {
  max-width: 9ch;
  margin: 12px 0 0;
  color: #fffdf8;
  font-family: "Noto Serif Display", Georgia, serif;
  font-size: clamp(3.2rem, 6vw, 6.2rem);
  font-weight: 300;
  letter-spacing: 0;
  line-height: 0.95;
}

.book-command-title p {
  max-width: 55ch;
  margin: 16px 0 0;
  color: rgba(245, 240, 232, 0.56);
  font-size: 0.98rem;
  font-weight: 300;
  line-height: 1.65;
}

.book-page-meta {
  min-width: 0;
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 0;
  border-top: 1px solid rgba(245, 240, 232, 0.12);
  border-bottom: 1px solid rgba(245, 240, 232, 0.12);
}

.book-page-meta span {
  min-height: 42px;
  display: inline-flex;
  align-items: center;
  padding: 0 14px;
  border-right: 1px solid rgba(245, 240, 232, 0.12);
  color: rgba(245, 240, 232, 0.62);
  font-family: "JetBrains Mono", "SF Mono", Menlo, monospace;
  font-size: 0.66rem;
  font-weight: 600;
  letter-spacing: 0;
  text-transform: uppercase;
  white-space: nowrap;
}

.book-page-meta span:first-child {
  padding-left: 0;
}

.book-page-meta span:last-child {
  border-right: 0;
  padding-right: 0;
  color: var(--book-gold-warm);
}

.book-command-actions {
  display: grid;
  gap: 10px;
  align-content: end;
}

.book-primary-action,
.book-secondary-action,
.book-edition-button {
  min-height: 40px;
  border-radius: var(--book-radius);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 0 15px;
  font-size: 0.74rem;
  font-weight: 700;
  letter-spacing: 0;
  text-transform: uppercase;
  text-decoration: none;
  cursor: pointer;
  transition:
    color 0.22s var(--book-ease),
    background 0.22s var(--book-ease),
    border-color 0.22s var(--book-ease),
    transform 0.22s var(--book-ease);
}

.book-primary-action {
  border: 1px solid var(--book-gold);
  background: var(--book-gold);
  color: var(--book-ink);
}

.book-primary-action:hover {
  background: #d4bc8a;
  border-color: #d4bc8a;
  transform: translateY(-1px);
}

.book-primary-action--disabled {
  opacity: 0.58;
  pointer-events: none;
}

.book-secondary-action,
.book-edition-button {
  border: 1px solid rgba(245, 240, 232, 0.14);
  background: transparent;
  color: rgba(245, 240, 232, 0.72);
}

.book-secondary-action:hover {
  color: #fffdf8;
  border-color: rgba(201, 165, 90, 0.42);
  background: rgba(201, 165, 90, 0.1);
}

.book-studio {
  margin-top: 30px;
  border: 1px solid rgba(255, 253, 248, 0.2);
  border-radius: var(--book-radius);
  background: var(--book-cream);
  color: var(--book-text);
  box-shadow: 0 38px 100px rgba(0, 0, 0, 0.36);
}

.book-studio-head {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 20px;
  align-items: center;
  padding: 20px clamp(20px, 2.4vw, 30px);
  border-bottom: 1px solid var(--book-hair);
}

.book-studio-head h2 {
  margin: 8px 0 0;
  color: var(--book-ink);
  font-family: "Noto Serif Display", Georgia, serif;
  font-size: clamp(1.9rem, 2.8vw, 3rem);
  font-weight: 300;
  letter-spacing: 0;
  line-height: 1.02;
}

.book-studio-head p {
  margin: 0;
  color: var(--book-text-faint);
  font-family: "JetBrains Mono", "SF Mono", Menlo, monospace;
  font-size: 0.66rem;
  font-weight: 600;
  letter-spacing: 0;
  text-transform: uppercase;
  white-space: nowrap;
}

.book-workbench {
  display: grid;
  grid-template-columns: minmax(250px, 320px) minmax(0, 1fr);
  gap: 0;
  align-items: stretch;
}

.book-output-panel,
.book-curation-panel,
.book-sequence-panel {
  min-width: 0;
}

.book-curation-panel {
  border-right: 1px solid var(--book-hair);
  background:
    linear-gradient(180deg, rgba(255, 253, 248, 0.62), rgba(245, 240, 232, 0.42));
}

.book-output-panel {
  padding: clamp(18px, 2vw, 28px);
}

.book-panel-section {
  min-width: 0;
  padding: 20px;
  border-top: 1px solid var(--book-hair-soft);
}

.book-panel-section:first-child {
  border-top: 0;
}

.book-panel-head h3,
.book-section-head h2 {
  margin: 8px 0 0;
  color: var(--book-ink);
  font-family: "Noto Serif Display", Georgia, serif;
  font-weight: 300;
  letter-spacing: 0;
  line-height: 1.05;
}

.book-panel-head h3 {
  font-size: 1.48rem;
}

.book-cover-editor {
  margin-top: 16px;
}

.book-cover-editor__stage {
  position: relative;
  width: 100%;
  aspect-ratio: 4 / 5;
  overflow: hidden;
  border: 1px solid var(--book-hair);
  border-radius: var(--book-radius);
  background: var(--book-cream-dark);
}

.book-cover-editor__stage::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(5, 5, 5, 0.44), transparent 48%);
  pointer-events: none;
}

.book-cover-editor__image {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
  object-position: top center;
  filter: grayscale(8%) brightness(0.94);
  transition:
    filter 0.65s var(--book-ease),
    transform 0.65s var(--book-ease);
}

.book-cover-editor:hover .book-cover-editor__image {
  filter: grayscale(0%) brightness(1);
  transform: scale(1.012);
}

.book-image--failed {
  opacity: 0;
}

.book-cover-editor__empty {
  position: absolute;
  inset: 0;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10px;
  color: var(--book-text-faint);
  cursor: pointer;
}

.book-cover-editor__empty span {
  color: var(--book-text-soft);
  font-family: "Noto Serif Display", Georgia, serif;
  font-size: 1.22rem;
  font-style: italic;
  font-weight: 300;
}

.book-cover-editor__footer {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr);
  gap: 10px;
  align-items: baseline;
  padding-top: 12px;
}

.book-cover-editor__footer span,
.book-edit-panel label,
.book-readiness-card__top span {
  color: var(--book-gold);
  font-family: "JetBrains Mono", "SF Mono", Menlo, monospace;
  font-size: 0.64rem;
  font-weight: 600;
  letter-spacing: 0;
  text-transform: uppercase;
}

.book-cover-editor__footer strong {
  min-width: 0;
  overflow: hidden;
  color: var(--book-text-soft);
  font-size: 0.82rem;
  font-weight: 500;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.book-edit-panel {
  display: grid;
  gap: 10px;
}

.book-edition-select {
  width: 100%;
  min-width: 0;
  height: 40px;
  border: 1px solid var(--book-hair);
  border-radius: var(--book-radius);
  background: rgba(255, 253, 248, 0.72);
  color: var(--book-text);
  padding: 0 12px;
  font-size: 0.84rem;
}

.book-edition-button {
  border-color: var(--book-hair);
  color: var(--book-text-soft);
}

.book-edition-button:hover:not(:disabled) {
  color: var(--book-ink);
  border-color: var(--book-hair-gold);
  background: rgba(201, 165, 90, 0.08);
}

.book-edition-button:disabled {
  cursor: not-allowed;
  opacity: 0.42;
}

.book-readiness-card__top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 14px;
}

.book-readiness-card__top strong {
  color: var(--book-ink);
  font-family: "Noto Serif Display", Georgia, serif;
  font-size: 2rem;
  font-weight: 300;
}

.book-readiness-card__track {
  height: 5px;
  margin-top: 13px;
  overflow: hidden;
  border-radius: 999px;
  background: rgba(5, 5, 5, 0.08);
}

.book-readiness-card__fill {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, var(--book-sage), var(--book-gold));
}

.book-readiness-card p {
  margin: 12px 0 0;
  color: var(--book-text-soft);
  font-size: 0.83rem;
  line-height: 1.45;
}

.book-signal-stack {
  display: grid;
  gap: 0;
  margin-top: 16px;
  border-top: 1px solid var(--book-hair-soft);
}

.book-signal {
  min-width: 0;
  display: grid;
  grid-template-columns: auto minmax(0, 1fr) auto;
  gap: 8px;
  align-items: center;
  min-height: 38px;
  border-bottom: 1px solid var(--book-hair-soft);
}

.book-signal__icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 18px;
  height: 18px;
  color: var(--book-text-faint);
}

.book-signal--met .book-signal__icon {
  color: var(--book-sage);
}

.book-signal__label,
.book-signal__detail {
  min-width: 0;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.book-signal__label {
  color: var(--book-text);
  font-size: 0.82rem;
  font-weight: 650;
}

.book-signal__detail {
  color: var(--book-text-faint);
  font-size: 0.72rem;
}

.book-sequence-panel {
  padding: clamp(20px, 2vw, 28px);
  border-top: 1px solid var(--book-hair);
}

.book-section-head {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 16px;
  align-items: end;
  margin-bottom: 20px;
}

.book-section-head h2 {
  font-size: clamp(2rem, 3vw, 3.2rem);
}

.book-section-head p {
  margin: 0;
  color: var(--book-text-faint);
  font-family: "JetBrains Mono", "SF Mono", Menlo, monospace;
  font-size: 0.66rem;
  font-weight: 600;
  letter-spacing: 0;
  text-transform: uppercase;
}

.book-sequence-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(176px, 1fr));
  gap: 14px;
}

.book-frame-card {
  position: relative;
  min-width: 0;
  overflow: hidden;
  border: 1px solid var(--book-hair);
  border-radius: var(--book-radius);
  background: var(--book-paper);
  transition:
    border-color 0.3s var(--book-ease),
    transform 0.3s var(--book-ease),
    box-shadow 0.3s var(--book-ease);
}

.book-frame-card:hover {
  border-color: var(--book-hair-gold);
  box-shadow: 0 18px 46px rgba(5, 5, 5, 0.13);
  transform: translateY(-2px);
}

.book-frame-card--dragging {
  box-shadow: 0 32px 86px rgba(5, 5, 5, 0.22);
}

.book-frame-card--cover {
  grid-column: span 2;
}

.book-frame-card__image-wrap {
  position: relative;
  aspect-ratio: 4 / 5;
  overflow: hidden;
  background: var(--book-cream-dark);
  cursor: grab;
}

.book-frame-card:not(.book-frame-card--cover) .book-frame-card__image-wrap {
  aspect-ratio: 3 / 4;
}

.book-frame-card__image-wrap:active {
  cursor: grabbing;
}

.book-frame-card__image {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
  object-position: top center;
  user-select: none;
  filter: grayscale(8%) brightness(0.93);
  transition:
    filter 0.65s var(--book-ease),
    transform 0.65s var(--book-ease);
}

.book-frame-card:hover .book-frame-card__image {
  filter: grayscale(0%) brightness(1);
  transform: scale(1.012);
}

.book-frame-card__image--private {
  opacity: 0.7;
  filter: grayscale(100%) brightness(0.72);
}

.book-frame-card__shade {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(to bottom, rgba(5, 5, 5, 0.28), transparent 36%),
    linear-gradient(to top, rgba(5, 5, 5, 0.55), transparent 48%);
  pointer-events: none;
}

.book-frame-card__number {
  position: absolute;
  top: 10px;
  left: 10px;
  color: rgba(255, 253, 248, 0.72);
  font-family: "Noto Serif Display", Georgia, serif;
  font-size: 1.55rem;
  font-weight: 300;
  line-height: 1;
  pointer-events: none;
}

.book-frame-card__badge {
  position: absolute;
  z-index: 2;
  display: inline-flex;
  align-items: center;
  gap: 5px;
  min-height: 22px;
  padding: 0 8px;
  border-radius: 999px;
  font-size: 0.62rem;
  font-weight: 700;
  letter-spacing: 0;
  text-transform: uppercase;
}

.book-frame-card__badge--cover {
  right: 10px;
  top: 10px;
  background: var(--book-gold);
  color: var(--book-ink);
}

.book-frame-card__badge--private {
  left: 10px;
  bottom: 10px;
  border: 1px solid rgba(255, 253, 248, 0.16);
  background: rgba(5, 5, 5, 0.72);
  color: rgba(255, 253, 248, 0.86);
}

.book-frame-card__body {
  position: relative;
  min-height: 62px;
  padding: 12px;
  border-top: 1px solid var(--book-hair-soft);
}

.book-frame-card__eyebrow {
  display: block;
  margin-bottom: 5px;
  overflow: hidden;
  color: var(--book-text-faint);
  font-size: 0.62rem;
  font-weight: 700;
  letter-spacing: 0;
  text-overflow: ellipsis;
  text-transform: uppercase;
  white-space: nowrap;
}

.book-frame-card__title {
  margin: 0;
  overflow: hidden;
  color: var(--book-text);
  font-family: "Noto Serif Display", Georgia, serif;
  font-size: 1rem;
  font-weight: 300;
  letter-spacing: 0;
  line-height: 1.1;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.book-frame-card__actions {
  position: absolute;
  right: 9px;
  top: -42px;
  z-index: 3;
  display: flex;
  align-items: center;
  gap: 5px;
}

.book-frame-action {
  width: 30px;
  height: 30px;
  border: 1px solid rgba(255, 253, 248, 0.34);
  border-radius: 50%;
  background: rgba(255, 253, 248, 0.92);
  color: var(--book-text-soft);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition:
    color 0.2s var(--book-ease),
    background 0.2s var(--book-ease),
    border-color 0.2s var(--book-ease),
    transform 0.2s var(--book-ease);
}

.book-frame-action svg {
  width: 14px;
  height: 14px;
  display: block;
  stroke: currentColor;
  stroke-width: 2.1;
}

.book-frame-action:hover:not(:disabled) {
  color: var(--book-gold);
  border-color: var(--book-hair-gold);
  background: rgba(255, 253, 248, 0.98);
  transform: translateY(-1px);
}

.book-frame-action--danger:hover:not(:disabled) {
  color: var(--book-danger);
  border-color: rgba(156, 61, 53, 0.28);
  background: rgba(156, 61, 53, 0.08);
}

.book-frame-action:disabled {
  opacity: 0.48;
  cursor: not-allowed;
}

.book-frame-action:focus-visible,
.book-edition-button:focus-visible,
.book-secondary-action:focus-visible,
.book-primary-action:focus-visible,
.book-edition-select:focus-visible {
  outline: 2px solid rgba(201, 165, 90, 0.55);
  outline-offset: 2px;
}

.book-frame-action__spinner {
  animation: book-action-spin 0.7s linear infinite;
}

.book-frame-card--skeleton {
  pointer-events: none;
}

.book-frame-card--skeleton .book-frame-card__image-wrap,
.book-frame-card--skeleton .book-frame-card__body {
  background: linear-gradient(
    90deg,
    rgba(5, 5, 5, 0.035) 0%,
    rgba(5, 5, 5, 0.08) 20%,
    rgba(5, 5, 5, 0.035) 42%,
    rgba(5, 5, 5, 0.035) 100%
  );
  background-size: 1400px 100%;
  animation: book-shimmer 2s linear infinite;
}

.book-empty {
  min-height: 330px;
  border: 1px dashed var(--book-hair-gold);
  border-radius: var(--book-radius);
  background: rgba(255, 253, 248, 0.58);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16px;
  text-align: center;
}

.book-empty__mark {
  color: var(--book-gold);
}

.book-empty h3 {
  margin: 0;
  color: var(--book-text-soft);
  font-family: "Noto Serif Display", Georgia, serif;
  font-size: 2rem;
  font-style: italic;
  font-weight: 300;
  letter-spacing: 0;
}

@media (max-width: 1320px) {
  .book-command-bar {
    grid-template-columns: minmax(0, 1fr) auto;
  }

  .book-command-actions {
    grid-column: 1 / -1;
    grid-template-columns: repeat(2, max-content);
    justify-content: start;
  }
}

@media (max-width: 1100px) {
  .book-command-bar,
  .book-studio-head,
  .book-workbench {
    grid-template-columns: 1fr;
  }

  .book-page-meta {
    justify-content: flex-start;
  }

  .book-curation-panel {
    border-right: 0;
    border-bottom: 1px solid var(--book-hair);
    display: grid;
    grid-template-columns: minmax(230px, 0.9fr) minmax(220px, 0.8fr) minmax(260px, 1fr);
  }

  .book-panel-section {
    border-top: 0;
    border-left: 1px solid var(--book-hair-soft);
  }

  .book-panel-section:first-child {
    border-left: 0;
  }
}

@media (max-width: 820px) {
  .book-container {
    padding: 30px 16px 56px;
  }

  .book-command-actions,
  .book-curation-panel {
    grid-template-columns: 1fr;
  }

  .book-page-meta span {
    min-height: 34px;
    padding: 0 10px;
  }

  .book-panel-section,
  .book-panel-section:first-child {
    border-left: 0;
    border-top: 1px solid var(--book-hair-soft);
  }

  .book-panel-section:first-child {
    border-top: 0;
  }

  .book-section-head {
    grid-template-columns: 1fr;
    align-items: start;
  }

  .book-primary-action,
  .book-secondary-action,
  .book-edition-button {
    width: 100%;
  }
}

@media (max-width: 560px) {
  .book-command-title h1 {
    font-size: 3rem;
  }

  .book-studio-head,
  .book-output-panel,
  .book-sequence-panel {
    padding: 16px;
  }

  .book-sequence-grid {
    grid-template-columns: 1fr;
  }

  .book-frame-card--cover {
    grid-column: span 1;
  }

  .book-cover-editor__footer {
    grid-template-columns: 1fr;
  }

  .book-cover-editor__footer strong {
    text-align: left;
  }
}

@media (hover: none) and (pointer: coarse) {
  .book-frame-action {
    width: 36px;
    height: 36px;
  }
}
