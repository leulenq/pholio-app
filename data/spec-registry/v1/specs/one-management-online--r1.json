    { "id": "one-application-photo-instructions", "authority": "first_party_published", "publisher": "ONE Management", "url": "https://onemanagement.com/submissions/application", "title": "ONE Management - Application", "locale": "en", "retrievedOn": "2026-08-19", "locator": { "kind": "section", "value": "Photo Upload instructions and technical notes" }, "excerpt": "Please submit four photos of yourself: full length, waist up, close up, and profile. It is not necessary to hire a professional. 1) Shoot the photos in natural daylight. Please avoid direct sunlight. 2) Please do not use makeup or hairstyling - wear your hair down - no smiles or selfie style poses. 3) A white t-shirt/tank top and skinny jeans are ideal. Formats: jpg, jpeg, or png. File size: maximum 600 KB per image.", "archivedUrl": null, "contentHash": null },
    { "id": "one-application-form-dom", "authority": "first_party_published", "publisher": "ONE Management", "url": "https://onemanagement.com/submissions/application", "title": "ONE Management - Application", "locale": "en", "retrievedOn": "2026-08-19", "locator": { "kind": "form_field", "value": "application form control dump: first, last, gender, pronoun, age (min 16, max 80, step 0.25), skill, instagram, tiktok, email, phoneCountryCode, phoneNumber, city, country, unitType, heightFeet, heightInch, heightCm (152.5-212.75), shoesize, eyeColor, hairColor, waist, bust, chest, hips, image0-image3, walking, personality, acceptedTC, dead" }, "excerpt": "image/jpeg, image/png, image/jpg", "archivedUrl": null, "contentHash": null },
    { "id": "one-application-intro", "authority": "first_party_published", "publisher": "ONE Management", "url": "https://onemanagement.com/submissions/application", "title": "ONE Management - Application", "locale": "en", "retrievedOn": "2026-08-19", "locator": { "kind": "text_fragment", "value": "page introduction" }, "excerpt": "You don't need previous experience or expensive photos or videos to apply. We want to see you at your most natural - without make up, hair styling, selfie-style poses, or smiles - in daily clothes. For the photo and videos a smart phone is more than sufficient.", "archivedUrl": null, "contentHash": null },
    { "id": "one-application-video-section", "authority": "first_party_published", "publisher": "ONE Management", "url": "https://onemanagement.com/submissions/application", "title": "ONE Management - Application", "locale": "en", "retrievedOn": "2026-08-19", "locator": { "kind": "section", "value": "Video Upload section" }, "excerpt": "Video 1: Please submit a short 30 second Walking Video of yourself. Video 2: Please submit a short 30 second Personality Video of yourself. If do not have videos links to submit or you cannot enter the video link in the application, then you can leave the fields for video links empty.", "archivedUrl": null, "contentHash": null },
    { "id": "one-process-and-rules", "authority": "first_party_published", "publisher": "ONE Management", "url": "https://onemanagement.com/submissions/processandrules", "title": "ONE Management - Process + Rules", "locale": "en", "retrievedOn": "2026-08-19", "locator": { "kind": "section", "value": "who may apply online" }, "excerpt": "If you are 13 years of age or younger, we are sorry but you may not apply online with us. Your parent or legal guardian can contact our offices to explore representation with us. If you are a minor between the ages of 14 and 18 you are welcome to apply online with the cooperation and consent of your parents or legal guardian.", "archivedUrl": null, "contentHash": null },
    { "id": "one-faq", "authority": "first_party_published", "publisher": "ONE Management", "url": "https://onemanagement.com/submissions/faq", "title": "ONE Management - FAQ", "locale": "en", "retrievedOn": "2026-08-19", "locator": { "kind": "section", "value": "requirements and photo guidance" }, "excerpt": "We do not have an age requirement to submit, but please note that we do not represent children. We do not have a height requirement to submit. However, please note that some clients that we serve in the industry might be more restrictive about height.", "archivedUrl": null, "contentHash": null }
  ],
  "review": { "authority": "first_party_published", "method": "dual_reviewer", "reviewers": [{ "id": "spec-registry-rebuild-lane-20260819", "reviewedOn": "2026-08-19" }, { "id": "normalization-review-20260829", "reviewedOn": "2026-08-29" }], "notes": "Normalized from the 2026-08-19 rebuild research. The age and height contradictions are recorded rather than resolved: every published position is carried as its own rule with its own basis - the form's numeric limits as form semantics, the Process + Rules text and the FAQ as published text - and the two conflicting unknowns name the disagreement so a talent is told the sources disagree instead of being handed one number. A fourteen-year-old that Process + Rules explicitly welcomes cannot get the form's age field to validate; that is the entry's most valuable sentence and it belongs in the brief. The videos are not uploads and are not required: they are two text fields for YouTube links with no required attribute, and the page itself says to leave them blank or email the links. This schema has no video mechanism, so nothing here asserts a video requirement and the unknown carries the fact. Duration guidance is contradictory across ONE's own pages - 30 seconds on the form, 15 to 40 seconds in the FAQ - and neither is asserted, since no video is submitted through this form. The accept attribute names image/jpg, which is not a real media type; the published format line and the two real types it maps to are what is recorded. Three form facts have no home in this schema: the Skills multi-select, the separate country-dialling-code select beside the phone number, and the hidden anti-spam field - which a talent must never be shown as something to fill in." }
}
