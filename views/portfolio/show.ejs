<%
  // Public portfolio: ONE rendering for every talent, regardless of payment
  // tier. Payment may only change what the talent keeps (e.g. PDF exports) —
  // never what an agency (or anyone else) sees on this page. Do not
  // reintroduce an `is_pro` fork here; gate content only on the field itself
  // being present, or on a non-tier visibility control (profile_field_visibility,
  // minorPublicExposureAllowed, etc.) computed upstream in the route.
%>
<section class="portfolio-hero">
  <div class="portfolio-hero__meta">
    <h1 class="display"><%= profile.first_name %> <%= profile.last_name %></h1>
    <p class="portfolio-location"><%= profile.city %></p>
    <%
      // Wave 2C: measurements render only when opted public (default: agency-
      // only). Age shown as an audience-safe band, never exact.
      // TODO(public-portfolio-DTO): gender, city, and social handles are still
      // rendered raw here — route this whole template through a public-card
      // DTO + per-field visibility in a follow-up pass.
      const publicStats = (typeof stats !== 'undefined' && stats) ? stats : null;
      const publicAgeBand = (typeof ageBand !== 'undefined') ? ageBand : null;
    %>
    <ul class="portfolio-stats">
      <% if (publicStats) { %>
        <% publicStats.fields.forEach((line) => { %>
          <li><span><%= line.label %></span> <%= line.value %></li>
        <% }) %>
        <% if (publicStats.weight) { %>
          <li><span>Weight</span> <%= publicStats.weight.dual %></li>
        <% } %>
      <% } %>
      <% if (profile.gender) { %>
        <li><span>Gender</span> <%= profile.gender %></li>
      <% } %>
      <% if (publicAgeBand) { %>
        <li><span>Age</span> <%= publicAgeBand %></li>
      <% } %>
      <% if (profile.languages) { %>
        <%
          let languagesArray = [];
          try {
            languagesArray = typeof profile.languages === 'string' ? JSON.parse(profile.languages) : profile.languages;
          } catch {
            languagesArray = [];
          }
          const languagesDisplay = Array.isArray(languagesArray) && languagesArray.length > 0
            ? languagesArray.join(', ')
            : (typeof profile.languages === 'string' ? profile.languages : '');
        %>
        <% if (languagesDisplay) { %>
          <li><span>Languages</span> <%= languagesDisplay %></li>
        <% } %>
      <% } %>
      <% if (profile.availability_travel !== null || profile.availability_schedule) { %>
        <%
          const availabilityParts = [];
          if (profile.availability_schedule) availabilityParts.push(profile.availability_schedule);
          if (profile.availability_travel === true) availabilityParts.push('Willing to travel');
          const availabilityDisplay = availabilityParts.join(' • ');
        %>
        <% if (availabilityDisplay) { %>
          <li><span>Availability</span> <%= availabilityDisplay %></li>
        <% } %>
      <% } %>
      <% if (profile.experience_level) { %>
        <li><span>Experience</span> <%= profile.experience_level %></li>
      <% } %>
    </ul>
  </div>
  <% if (profile.hero_image_path) { %>
    <figure class="portfolio-hero__image">
      <img src="<%= profile.hero_image_path %>" alt="Hero image for <%= profile.first_name %> <%= profile.last_name %>">
    </figure>
  <% } %>
</section>

<section class="portfolio-body">
  <article class="portfolio-bio">
    <h2>About</h2>
    <p><%= profile.bio_curated %></p>

    <% if (profile.training) { %>
      <div class="portfolio-training">
        <h3>Training</h3>
        <p><%= profile.training %></p>
      </div>
    <% } %>

    <% if (profile.portfolio_url) { %>
      <div class="portfolio-portfolio">
        <h3>Portfolio</h3>
        <p><a href="<%= profile.portfolio_url %>" target="_blank" rel="noopener"><%= profile.portfolio_url %></a></p>
      </div>
    <% } %>

    <% if (profile.instagram_handle || profile.twitter_handle || profile.tiktok_handle) { %>
      <div class="portfolio-social">
        <h3>Social Media</h3>
        <ul class="portfolio-social-list">
          <% if (profile.instagram_handle) { %>
            <li>
              <% if (profile.instagram_url) { %>
                <a href="<%= profile.instagram_url %>" target="_blank" rel="noopener" class="portfolio-social-link">Instagram: @<%= profile.instagram_handle %></a>
              <% } else { %>
                Instagram: @<%= profile.instagram_handle %>
              <% } %>
            </li>
          <% } %>
          <% if (profile.twitter_handle) { %>
            <li>
              <% if (profile.twitter_url) { %>
                <a href="<%= profile.twitter_url %>" target="_blank" rel="noopener" class="portfolio-social-link">Twitter: @<%= profile.twitter_handle %></a>
              <% } else { %>
                Twitter: @<%= profile.twitter_handle %>
              <% } %>
            </li>
          <% } %>
          <% if (profile.tiktok_handle) { %>
            <li>
              <% if (profile.tiktok_url) { %>
                <a href="<%= profile.tiktok_url %>" target="_blank" rel="noopener" class="portfolio-social-link">TikTok: @<%= profile.tiktok_handle %></a>
              <% } else { %>
                TikTok: @<%= profile.tiktok_handle %>
              <% } %>
            </li>
          <% } %>
        </ul>
      </div>
    <% } %>

    <%
      // Multi-value json columns: pg hands back arrays, SQLite the JSON text.
      const listDisplay = (value) => {
        if (!value) return '';
        let list = value;
        if (typeof value === 'string') {
          try { list = JSON.parse(value); } catch (e) { list = value; }
        }
        if (Array.isArray(list)) return list.filter(Boolean).join(', ');
        return typeof list === 'string' ? list : '';
      };
      const unionDisplay = listDisplay(profile.union_membership);
      const ethnicityDisplay = listDisplay(profile.ethnicity);
    %>
    <% if (profile.nationality || unionDisplay || ethnicityDisplay) { %>
      <div class="portfolio-additional-info">
        <h3>Additional Information</h3>
        <ul class="portfolio-info-list">
          <% if (profile.nationality) { %>
            <li><span>Nationality:</span> <%= profile.nationality %></li>
          <% } %>
          <% if (unionDisplay) { %>
            <li><span>Union:</span> <%= unionDisplay %></li>
          <% } %>
          <% if (ethnicityDisplay) { %>
            <li><span>Ethnicity:</span> <%= ethnicityDisplay %></li>
          <% } %>
        </ul>
      </div>
    <% } %>

    <% if (profile.tattoos === true || profile.piercings === true) { %>
      <div class="portfolio-physical-characteristics">
        <h3>Physical Characteristics</h3>
        <ul class="portfolio-info-list">
          <% if (profile.tattoos === true) { %>
            <li>Has visible tattoos</li>
          <% } %>
          <% if (profile.piercings === true) { %>
            <li>Has visible piercings</li>
          <% } %>
        </ul>
      </div>
    <% } %>
  </article>

  <section class="portfolio-gallery">
    <h2>Gallery</h2>
    <div class="portfolio-grid">
      <% images.forEach((item) => { %>
        <figure data-image-id="<%= item.id %>">
          <img src="<%= item.path %>" alt="<%= item.label || 'Portfolio image' %>">
          <figcaption><%= item.label || 'Portfolio image' %></figcaption>
        </figure>
      <% }) %>
    </div>
  </section>
</section>

<script>
  (function() {
    const slug = '<%= profile.slug %>';
    const trackEvent = (eventType, metadata = {}) => {
      fetch(`/portfolio/${slug}/event`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ eventType, metadata })
      }).catch(err => console.error('Tracking error:', err));
    };

    // Track Bio View (Engagement)
    const bioSection = document.querySelector('.portfolio-bio');
    if (bioSection) {
      let bioViewStartTime = null;
      let bioTracked = false;
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting && !bioTracked) {
            bioViewStartTime = Date.now();
          } else if (bioViewStartTime && !bioTracked) {
            const duration = Date.now() - bioViewStartTime;
            if (duration > 3000) { // Considered a "read" if viewed for > 3s
              trackEvent('bio_read', { duration });
              bioTracked = true;
            }
            bioViewStartTime = null;
          }
        });
      }, { threshold: 0.5 });
      observer.observe(bioSection);
    }

    // Track Outbound Clicks
    document.addEventListener('click', (e) => {
      const link = e.target.closest('a');
      if (!link) return;

      const href = link.href;
      if (href.includes('instagram.com')) trackEvent('social_click', { platform: 'instagram', url: href });
      else if (href.includes('twitter.com')) trackEvent('social_click', { platform: 'twitter', url: href });
      else if (href.includes('tiktok.com')) trackEvent('social_click', { platform: 'tiktok', url: href });
      else if (link.classList.contains('portfolio-social-link') || link.closest('.portfolio-portfolio')) {
        trackEvent('portfolio_click', { url: href });
      }
    });

    // Record only observable frame actions: shown in the viewport and opened.
    (() => {
      const frames = document.querySelectorAll('[data-image-id]');
      if (!frames.length || !('IntersectionObserver' in window)) return;
      const seen = new Set();
      const record = (eventType, imageId) => {
        fetch(`/portfolio/${slug}/event`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ eventType, imageId })
        }).catch(() => {});
      };
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          const id = entry.target.getAttribute('data-image-id');
          if (!entry.isIntersecting || !id || seen.has(id)) return;
          seen.add(id);
          record('image_impression', id);
        });
      }, { threshold: 0.6 });
      frames.forEach((frame) => {
        observer.observe(frame);
        frame.addEventListener('click', () => {
          const id = frame.getAttribute('data-image-id');
          if (id) record('image_open', id);
        });
      });
    })();

    // Track Scroll Depth
    let maxDepthReached = 0;
    window.addEventListener('scroll', () => {
      const winHeight = window.innerHeight;
      const docHeight = document.documentElement.scrollHeight - winHeight;
      const scrollPos = window.scrollY;
      const currentPercent = Math.round((scrollPos / docHeight) * 100);

      const milestones = [25, 50, 75, 100];
      milestones.forEach(m => {
        if (currentPercent >= m && maxDepthReached < m) {
          maxDepthReached = m;
          trackEvent('scroll_depth', { percent: m });
        }
      });
    }, { passive: true });
  })();
</script>

<script>
  (function() {
    const params = new URLSearchParams(window.location.search);
    const agencyId = params.get('agency_id');
    const token = params.get('token');
    const ref = params.get('ref');

    if (ref === 'agency' && agencyId && token) {
      // Create and show modal
      const modal = document.createElement('div');
      modal.innerHTML = `
        <div style="position: fixed; inset: 0; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 10000; font-family: sans-serif;">
            <div style="background: white; padding: 2rem; border-radius: 12px; max-width: 400px; width: 90%; text-align: center; box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);">
                <h3 style="margin: 0 0 0.5rem; font-size: 1.25rem; font-weight: 600; color: #0f172a;">Agency Invitation</h3>
                <p style="margin: 0 0 1.5rem; color: #64748b;">An agency has invited you to apply directly to their roster.</p>
                <div style="display: flex; gap: 1rem; justify-content: center;">
                    <button id="cancel-app" style="padding: 0.5rem 1rem; border: 1px solid #e2e8f0; background: white; border-radius: 6px; cursor: pointer; color: #475569;">Cancel</button>
                    <button id="confirm-app" style="padding: 0.5rem 1rem; background: #0f172a; color: white; border: none; border-radius: 6px; cursor: pointer; font-weight: 500;">Apply Now</button>
                </div>
            </div>
        </div>
      `;
      document.body.appendChild(modal);

      document.getElementById('cancel-app').onclick = () => modal.remove();
      document.getElementById('confirm-app').onclick = async () => {
          const btn = document.getElementById('confirm-app');
          const originalText = btn.innerText;
          btn.innerText = 'Applying...';
          btn.disabled = true;

          try {
              const res = await fetch('/api/talent/redirect-apply', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ agencyId, token })
              });

              if (res.status === 401 || res.status === 403) {
                  // Redirect to login
                  alert('Please login to accept this invitation.');
                  window.location.href = '/login?redirect=' + encodeURIComponent(window.location.href);
                  return;
              }

              const data = await res.json();

              if (res.ok && data.success) {
                  modal.innerHTML = `
                    <div style="position: fixed; inset: 0; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 10000; font-family: sans-serif;">
                        <div style="background: white; padding: 2rem; border-radius: 12px; max-width: 400px; width: 90%; text-align: center;">
                            <h3 style="margin: 0 0 0.5rem; color: #16a34a;">Application Sent!</h3>
                            <p style="margin: 0; color: #64748b;">The agency has received your application.</p>
                            <button onclick="window.location.href=window.location.pathname" style="margin-top: 1rem; padding: 0.5rem 1rem; background: #0f172a; color: white; border: none; border-radius: 6px; cursor: pointer;" >Close</button>
                        </div>
                    </div>
                  `;
              } else if (data.message === 'Already applied') {
                   alert('You have already applied to this agency.');
                   modal.remove();
              } else {
                  throw new Error(data.error || 'Failed to apply');
              }
          } catch (err) {
              alert(err.message);
              btn.innerText = originalText;
              btn.disabled = false;
          }
      };
    }
  })();
</script>
