{
  "name": "Pholio",
  "version": "1.0.0",
  "description": "Pholio.studio yo",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon server.js",
    "client:dev": "cd client && npm run dev",
    "client:build": "cd client && npm run build",
    "dev:all": "concurrently -k \"npm run dev\" \"wait-on tcp:127.0.0.1:3000 -t 60000 && npm run client:dev\"",
    "migrate": "knex migrate:latest",
    "migrate:status": "knex migrate:status",
    "migrate:rollback": "knex migrate:rollback",
    "seed": "knex seed:run",
    "seed:analytics": "node scripts/seed-analytics.js",
    "preview:emails": "node scripts/preview-all-emails.js",
    "backfill:classification": "node scripts/backfill-image-classification.js",
    "backfill:strip-vision-sensitive": "node scripts/strip-vision-sensitive-fields.js",
    "backfill:image-signals": "node scripts/backfill-image-signals.js",
    "backfill:profile-market": "node scripts/backfill-profile-market.js",
    "analyze:classification-feedback": "node scripts/analyze-classification-feedback.js",
    "moderation:queue": "node scripts/moderation-queue.js",
    "validate:spec-registry": "node scripts/validate-spec-registry.js",
    "sync:spec-registry": "node scripts/sync-spec-registry.js",
    "map:spec-registry-agencies": "node scripts/map-spec-registry-agencies.js",
    "verify:spec-registry-release": "node scripts/map-spec-registry-agencies.js --verify-only",
    "delist:spec-registry": "node scripts/delist-spec-registry-agency.js",
    "report:spec-registry-engagement": "node scripts/spec-registry-engagement.js",
    "release:spec-registry": "npm run migrate && npm run sync:spec-registry && npm run map:spec-registry-agencies && npm run verify:spec-registry-release",
    "validate:trust-registry": "node scripts/validate-trust-registry.js",
    "sync:trust-registry": "node scripts/sync-trust-registry.js",
    "verify:trust-registry-release": "node scripts/sync-trust-registry.js --verify-only",
    "release:trust-registry": "npm run validate:trust-registry && npm run sync:trust-registry",
    "test": "node scripts/run-jest.js --runInBand --forceExit",
    "test:db": "node scripts/test-neon-connection.js",
    "setup:hooks": "sh scripts/setup-git-hooks.sh",
    "postinstall": "node scripts/patch-express.js && npm run setup:hooks",
    "build": "echo 'Build complete'",
    "build:function": "node_modules/.bin/esbuild netlify/function/server.js --bundle --platform=node --target=node20 --outfile=netlify/function-built/server.js --external:bcrypt --external:sharp --external:@img --external:@unrs --external:fsevents --external:sqlite3 --external:better-sqlite3 --external:mysql --external:mysql2 --external:tedious --external:oracledb --external:pg-native --external:pg-query-stream --external:mssql --external:@sparticuz/chromium --external:puppeteer --external:mime --external:zod --external:validator --external:ejs --external:express-ejs-layouts --external:harfbuzzjs",
    "gallery": "node scripts/comp-card-gallery.js",
    "generate:favicons": "node scripts/generate-favicons.js",
    "setup:sender-avatar": "node scripts/setup-email-sender-avatar.js",
    "setup:env": "node scripts/setup-env.js",
    "setup:stripe-billing": "node scripts/setup-stripe-billing.js --write",
    "build:migrate": "npm run migrate && npm run build",
    "netlify:cache-bust": "echo 3"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1008.0",
    "@sparticuz/chromium": "^149.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "bcrypt": "^6.0.0",
    "chrono-node": "^2.9.0",
    "connect-session-knex": "3.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "ejs": "3.1.10",
    "esbuild": "^0.25.0",
    "express": "4.22.2",
    "express-async-handler": "^1.2.0",
    "express-ejs-layouts": "^2.5.1",
    "express-rate-limit": "^8.2.1",
    "express-session": "^1.19.0",
    "firebase-admin": "^13.7.0",
    "groq-sdk": "^0.37.0",
    "harfbuzzjs": "^1.4.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.1.0",
    "multer": "^2.0.2",
    "multer-s3": "^3.0.1",
    "nodemailer": "^8.0.1",
    "passkit-generator": "^3.5.7",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "pg": "^8.19.0",
    "puppeteer": "^25.3.0",
    "qrcode": "^1.5.4",
    "serverless-http": "^3.2.0",
    "sharp": "^0.35.3",
    "stripe": "^20.4.0",
    "uuid": "^9.0.1",
    "validator": "^13.12.0",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "@img/sharp-libvips-linux-x64": "1.3.2",
    "@img/sharp-linux-x64": "0.35.3",
    "sqlite3": "6.0.1"
  },
  "devDependencies": {
    "axios": "^1.13.5",
    "axios-cookiejar-support": "^6.0.5",
    "concurrently": "^9.2.1",
    "cookie-signature": "^1.2.2",
    "form-data": "^4.0.3",
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "pixelmatch": "^5.3.0",
    "supertest": "^7.2.2",
    "tough-cookie": "^6.0.0",
    "wait-on": "^9.0.10"
  },
  "overrides": {
    "shell-quote": "1.8.4"
  }
}
