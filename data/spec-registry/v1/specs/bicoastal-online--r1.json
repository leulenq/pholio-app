  "evidence": [
    { "id": "bicoastal-get-scouted-intro", "authority": "first_party_published", "publisher": "Bicoastal Mgmt", "url": "https://www.bicoastalmgmt.com/get-scouted", "title": "Scouting Print Fashion Commercial Kids Plus Fitness & Fit models", "locale": "en", "retrievedOn": "2026-08-19", "locator": { "kind": "text_fragment", "value": "Get Scouted introduction" }, "excerpt": "BICOASTAL MGMT is always looking for potential fit models with consistent measurements and experience, NYC and LA based development models, and experienced commercial actors, fashion, print, plus models and talent of all ages and types. We can't answer every submission but appreciate your application! No calls please.", "archivedUrl": null, "contentHash": null },
    { "id": "bicoastal-get-scouted-form-dom", "authority": "first_party_published", "publisher": "Bicoastal Mgmt", "url": "https://www.bicoastalmgmt.com/get-scouted", "title": "Scouting Print Fashion Commercial Kids Plus Fitness & Fit models", "locale": "en", "retrievedOn": "2026-08-19", "locator": { "kind": "form_field", "value": "get-scouted form control dump: gender toggle, firstName, lastName, email, contactNumber, city, stateProvince, country, birthday, nationality, ethnicity, social_instagram, social_tiktok, website, stats comboboxes, terms, and the resume, video, closeUp, fullBody, sideProfile and upperBody uploads" }, "excerpt": "image/*, image/heic, image/heif", "archivedUrl": null, "contentHash": null },
    { "id": "bicoastal-privacy-age-requirement", "authority": "first_party_published", "publisher": "Bicoastal Mgmt", "url": "https://www.bicoastalmgmt.com/privacy-policy", "title": "Bicoastal Mgmt - Privacy Policy", "locale": "en", "retrievedOn": "2026-08-19", "locator": { "kind": "section", "value": "6.4 AGE REQUIREMENT AND PARENTAL CONSENT" }, "excerpt": "You must be 18 years of age or older to submit a talent application independently. If you are under 18, your application must be submitted by a parent or legal guardian who accepts this Privacy Policy on your behalf. For applicants under 18, we require written parental or guardian consent before processing the application. Please contact us at billing@bicoastalmgmt.com for the appropriate consent form.", "archivedUrl": null, "contentHash": null },
    { "id": "bicoastal-about", "authority": "first_party_published", "publisher": "Bicoastal Mgmt", "url": "https://www.bicoastalmgmt.com/about", "title": "Bicoastal Mgmt - About", "locale": "en", "retrievedOn": "2026-08-19", "locator": { "kind": "section", "value": "registration and fees" }, "excerpt": "Certificate Number: 26-675G6-LSFW / Issued: 01/21/2026 / Expires: 01/21/2028 / Status: Registered. Our models and talent do not pay any upfront fees for any service.", "archivedUrl": null, "contentHash": null }
  ],
  "review": { "authority": "first_party_published", "method": "dual_reviewer", "reviewers": [{ "id": "spec-registry-rebuild-lane-20260819", "reviewedOn": "2026-08-19" }, { "id": "normalization-review-20260829", "reviewedOn": "2026-08-29" }], "notes": "Normalized from the 2026-08-19 rebuild research. The four photo slots are required and named by the form itself; UPPER BODY is mapped to the waist-up frame and its verbatim label is kept beside it. No mime rule is asserted: the photo inputs accept image/* with HEIC and HEIF named, which is a wildcard rather than a format list, so it is recorded as an ambiguous unknown and an export defaults to JPEG rather than to a format the registry invented. The age requirement is published in the privacy policy, not on the form, and the form contradicts it - no age gate, no guardian field, a 2015 date of birth accepted silently - so the rules carry the policy and the unknown carries the contradiction. Four form facts have no home in this schema and are recorded here: the optional resume (.pdf) and show-reel (.mp4) uploads, the Ethnicity and Website fields, the Collar and Suit fields that appear only under Non-binary, and the gender selector's behaviour - Female is preselected before any interaction, and choosing Male renders the same stat fields as Female while only Non-binary renders Chest, Collar and Suit. That last one is a live template defect and is not presented here as an intended men's stat schema. One process contradiction is left unresolved as the research found it: the form says the agency cannot answer every submission, while privacy policy 6.3 says an unsuccessful applicant is notified of the six-month retention period at the time of the decision." }
}
