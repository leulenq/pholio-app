# Copy to .env and fill in values. See README.md for full documentation.

NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
MARKETING_SITE_URL=http://localhost:3001
COOKIE_DOMAIN=localhost
SESSION_SECRET=change-me

# Database — SQLite default; Postgres required for Discover semantic search (pgvector)
DB_CLIENT=sqlite3
DATABASE_URL=sqlite://./dev.sqlite3
# DB_CLIENT=pg
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Groq — vision / casting analysis (Scout, Director, image analysis)
GROQ_API_KEY=
# GROQ_TEXT_MODEL=llama-3.3-70b-versatile
# GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Instagram OAuth (Meta App Dashboard → Instagram → API setup with Instagram login)
# Requires a Creator or Business Instagram account for end users.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/auth/instagram/callback
# INSTAGRAM_OAUTH_SCOPE=instagram_business_basic

# OpenAI — Discover semantic search embeddings (text-embedding-3-small @ 512 dims)
OPENAI_API_KEY=

# Optional Discover search tuning (legacy single-vector path)
# DISCOVER_MAX_DISTANCE=0.55
# DISCOVER_FUSION_TEXT_WEIGHT=0.6
# DISCOVER_FUSION_IMAGE_WEIGHT=0.4

# Hybrid multi-retriever Discover (set true to enable)
# DISCOVER_HYBRID=false

# Agency RBAC — set false to log permission violations without blocking (rollout)
# AGENCY_RBAC_ENFORCE=true
# DISCOVER_RETRIEVAL_TOP_K=80
# DISCOVER_RERANK_TOP_K=50
# DISCOVER_RERANK_PROVIDER=groq
# DISCOVER_MIN_RERANK_SCORE=40
# DISCOVER_RRF_K=60
