<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title || 'Pholio' %></title>
    <link rel="stylesheet" href="/styles/global.css">
    <style>
        /* Chrome-less canvas for Studio+ public portfolios — the book is the page. */
        body { margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; background: #000; color: #fff; }
        main { min-height: 100vh; display: flex; flex-direction: column; }
    </style>
</head>
<body>
    <main>
        <%- body %>
    </main>
</body>
</html>
