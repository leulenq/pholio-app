{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pholio.studio/schemas/spec-registry/v1/manifest.schema.json",
  "title": "Pholio Spec Registry manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "taxonomyVersion",
    "datasetVersion",
    "publishedOn",
    "records"
  ],
  "properties": {
    "$schema": {
      "const": "./schemas/manifest.schema.json"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "taxonomyVersion": {
      "const": "1.0.0"
    },
    "datasetVersion": {
      "type": "string",
      "pattern": "^[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}\\.[1-9][0-9]*$"
    },
    "publishedOn": {
      "type": "string",
      "format": "date"
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "seriesId",
          "currentRevisionId",
          "path",
          "status"
        ],
        "properties": {
          "seriesId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._:-]*$"
          },
          "currentRevisionId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9:-]*@[1-9][0-9]*$"
          },
          "path": {
            "type": "string",
            "pattern": "^specs/[a-z0-9][a-z0-9-]*--r[1-9][0-9]*\\.json$"
          },
          "status": {
            "enum": [
              "draft",
              "provisional",
              "verified",
              "conflicting",
              "stale",
              "retired"
            ]
          }
        }
      }
    }
  }
}
