# Copy to .env and fill in values. See README.md for full documentation.

NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
MARKETING_SITE_URL=http://localhost:3001
COOKIE_DOMAIN=localhost
SESSION_SECRET=change-me

# Dev-only auth passthrough flag used by local sign-in shortcuts.
# When set to 1 (and NODE_ENV !== production) it enables POST /api/dev/login,
# which verifies the seeded bcrypt password so the /login page works with the
# seeded accounts without Firebase (e.g. agency@example.com / password123).
# Also set VITE_AUTH_PASSTHROUGH_ENABLED=1 in client/.env.local so the login
# form routes through this endpoint.
# AUTH_PASSTHROUGH_ENABLED=1

# Database — SQLite default; Postgres required for Discover semantic search (pgvector)
DB_CLIENT=sqlite3
DATABASE_URL=sqlite://./dev.sqlite3
# DB_CLIENT=pg
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Groq — vision / casting analysis (Scout, Director, image analysis)
GROQ_API_KEY=
# Provider-backed image analysis and profile embeddings remain off unless the
# deployment enables them and the adult talent separately opts in in Settings.
PHOLIO_ENABLE_IMAGE_ANALYSIS=false
PHOLIO_ENABLE_PROFILE_EMBEDDINGS=false
# GROQ_TEXT_MODEL=llama-3.3-70b-versatile
# GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Instagram OAuth (Meta App Dashboard → Instagram → API setup with Instagram login)
# Requires a Creator or Business Instagram account for end users.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/auth/instagram/callback
# INSTAGRAM_OAUTH_SCOPE=instagram_business_basic

# OpenAI — Discover semantic search embeddings (text-embedding-3-small @ 512 dims)
OPENAI_API_KEY=

# Stripe — Studio+ talent subscriptions ($9.99/month or $95.88/year, 14-day trial at checkout)
STRIPE_SECRET_KEY=
# Server-side publishable key (config.js: config.stripe.publishableKey).
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_ANNUAL=
# Uploaded by: node scripts/setup-stripe-billing.js --brand --write
STRIPE_BRAND_ICON_FILE_ID=
STRIPE_BRAND_LOGO_FILE_ID=
# Legacy monthly fallback supported by the app:
# STRIPE_PRICE_ID=

# Stripe Identity age verification (talent adult-content gate). The client
# (client/src/domains/talent/pages/ProfilePage/stripeIdentity.js) prefers the
# in-app Stripe.js modal via stripe.verifyIdentity(client_secret); that modal
# only engages when BOTH the session-creation response includes client_secret
# AND the client build exposes a publishable key here. Without this, the
# client falls back to a full-page redirect to the session's hosted url —
# functionally fine, just a different Stripe-owned UI, not a broken flow.
# Same value as STRIPE_PUBLISHABLE_KEY above; set in client/.env.local for dev
# (Vite only exposes VITE_-prefixed vars to the browser bundle).
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Optional Discover search tuning (legacy single-vector path)
# DISCOVER_MAX_DISTANCE=0.55
# DISCOVER_FUSION_TEXT_WEIGHT=0.6
# DISCOVER_FUSION_IMAGE_WEIGHT=0.4

# Hybrid multi-retriever Discover (set true to enable)
# DISCOVER_HYBRID=false

# Agency RBAC — set false to log permission violations without blocking (rollout)
# AGENCY_RBAC_ENFORCE=true

# SMTP — transactional email (guardian consent, application status, agency
# invites, new-message notifications). NOTE: password reset and email
# verification are handled directly by the Firebase client SDK, not by this
# SMTP config — see docs/email-setup.md.
# REQUIRED IN PRODUCTION: if SMTP_HOST is unset, email.js silently falls back
# to a no-op mock transporter and NO real email is ever sent — see
# docs/email-setup.md for the full checklist and root-cause writeup.
# Resend example: host=smtp.resend.com, port=465, user=resend, pass=<API key>
# Emails never use localhost links — they default to https://app.pholio.studio
# Override only for staging/preview deploys:
# EMAIL_APP_URL=https://deploy-preview-123--app.netlify.app
# EMAIL_MARKETING_SITE_URL=https://www.pholio.studio
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=Pholio <noreply@pholio.studio>
# Public brand mark for email headers + inbox sender avatar (Gravatar):
# EMAIL_BRAND_MARK_URL=https://app.pholio.studio/brand/pholio-sender-avatar.png
# DISCOVER_RETRIEVAL_TOP_K=80
# DISCOVER_RERANK_TOP_K=50
# DISCOVER_RERANK_PROVIDER=groq
# DISCOVER_MIN_RERANK_SCORE=40
# DISCOVER_RRF_K=60

# Sentry — production React crash reporting (client)
# Browser-safe Vite values (exposed to the SPA bundle):
# VITE_SENTRY_DSN=
# VITE_SENTRY_ENVIRONMENT=production
# VITE_SENTRY_RELEASE=
# Build-only upload credentials for private source maps in CI.
# Do NOT prefix these with VITE_ — they must never reach the browser bundle.
# Optional locally; required in production CI for readable source-mapped stacks.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
