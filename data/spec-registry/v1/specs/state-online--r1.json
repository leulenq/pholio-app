    { "id": "state-become-a-model-instructions", "authority": "first_party_published", "publisher": "State Management", "url": "https://www.statemgmt.com/become-a-model", "title": "State Management - Become a Model", "locale": "en", "retrievedOn": "2026-08-19", "locator": { "kind": "text_fragment", "value": "photo instructions above the upload slots" }, "excerpt": "Please submit four photos of yourself: close-up, waist-up, full-length, and 3/4 profile. Digitals shot in natural daylight (not direct sunlight) with no makeup, hair down, and neutral face are encouraged. We are looking for your natural beauty to shine through!", "archivedUrl": null, "contentHash": null },
