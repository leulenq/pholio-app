    { "id": "ford-get-scouted-city-routing", "authority": "first_party_published", "publisher": "Ford Models, Inc.", "url": "https://www.fordmodels.com/get-scouted", "title": "Get Scouted | Ford Models", "locale": "en", "retrievedOn": "2026-08-19", "locator": { "kind": "section", "value": "city selector and the form it mounts" }, "excerpt": "New York, Chicago, Los Angeles, Miami and Barcelona mount the selectroom.app embed; Paris mounts agency.getsnapcast.com/registrants/new_ford. New York is the city selected on load.", "archivedUrl": null, "contentHash": null },
