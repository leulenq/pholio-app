{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pholio.studio/schemas/spec-registry/v1/taxonomy.schema.json",
  "title": "Pholio Spec Registry taxonomy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "taxonomyVersion",
    "fields",
    "unknownFacts"
  ],
  "properties": {
    "$schema": {
      "const": "./schemas/taxonomy.schema.json"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "taxonomyVersion": {
      "const": "1.0.0"
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/field"
      }
    },
    "unknownFacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/unknownFact"
      }
    }
  },
  "$defs": {
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "description",
        "category",
        "valueType",
        "unit",
        "allowedValues",
        "matchabilityDefault"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "enum": [
            "shot",
            "appearance",
            "expression",
            "clothing",
            "capture",
            "alteration",
            "file",
            "applicant",
            "contact",
            "social",
            "measurements",
            "guardian",
            "consent",
            "application"
          ]
        },
        "valueType": {
          "enum": [
            "string",
            "number",
            "boolean",
            "date"
          ]
        },
        "unit": {
          "enum": [
            null,
            "cm",
            "year",
            "byte",
            "count"
          ]
        },
        "allowedValues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/value"
          }
        },
        "matchabilityDefault": {
          "enum": [
            "automatic",
            "manual_confirmation",
            "hybrid",
            "not_evaluable"
          ]
        }
      }
    },
    "unknownFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "value": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "description",
        "aliases"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_:-]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
