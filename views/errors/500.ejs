<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title || 'Server Error' %> · Pholio</title>
  <style>
    body { margin: 0; min-height: 100vh; display: flex; align-items: center; justify-content: center;
      background: #050505; color: rgba(255,255,255,0.88); font-family: Georgia, "Times New Roman", serif; }
    .wrap { text-align: center; padding: 48px 24px; max-width: 36rem; }
    .mark { color: #C9A55A; letter-spacing: 0.2em; font-size: 14px; margin-bottom: 24px; }
    h1 { font-weight: 400; font-size: 28px; margin: 0 0 12px; color: #fff; }
    p { font-family: system-ui, sans-serif; font-size: 15px; line-height: 1.6; color: rgba(255,255,255,0.55); margin: 0; }
    pre { text-align: left; margin-top: 24px; padding: 16px; background: rgba(255,255,255,0.06); border-radius: 8px;
      font-size: 12px; overflow: auto; color: rgba(255,255,255,0.7); }
  </style>
</head>
<body>
  <div class="wrap">
    <div class="mark">PHOLIO</div>
    <h1><%= title || 'Something went wrong' %></h1>
    <p><%= error && error.message ? error.message : 'Please try again in a moment.' %></p>
    <% if (showDetails && error && error.details) { %>
      <pre><%= typeof error.details === 'string' ? error.details : JSON.stringify(error.details, null, 2) %></pre>
    <% } %>
  </div>
</body>
</html>
